# The myshopify domain of the store (not the custom domain).
SHOPIFY_STORE_DOMAIN=sincerely-ironic-apparel.myshopify.com

# Public Storefront API access token. Shopify admin → Sales channels →
# Headless → your storefront → Storefront API → public access token.
# Until this is set the site renders from the local catalogue and the
# register stays closed.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
